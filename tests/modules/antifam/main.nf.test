nextflow_process {

    name "Test Process PARSE_ANTIFAM"
    script "modules/antifam/main.nf"
    process "PARSE_ANTIFAM"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = [1, file("${projectDir}/tests/data/antifam/hmmsearch.out")]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
