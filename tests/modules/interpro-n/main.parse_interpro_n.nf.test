nextflow_process {

    name "Test Process PARSE_INTERPRO_N"
    script "modules/interpro-n/main.nf"
    process "PARSE_INTERPRO_N"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = channel.of(tuple(
                    1,
                    [file("${projectDir}/tests/data/interpro-n/output.json", checkIfExists: true)]
                ))
                input[1] = ["cathgene3d", "pirsf", "prints", "sfld", "smart", "superfamily"]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
