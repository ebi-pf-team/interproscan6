nextflow_process {

    name "Test Process WRITE_FASTA"
    script "modules/phobius/main.nf"
    process "WRITE_FASTA"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = channel.of(tuple(1, file("${projectDir}/tests/data/phobius/sequences.fasta", checkIfExists: true)))
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
