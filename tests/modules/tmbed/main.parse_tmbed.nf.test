nextflow_process {

    name "Test Process PARSE_TMBED"
    script "modules/tmbed/main.nf"
    process "PARSE_TMBED"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = channel.of(tuple(1, file("${projectDir}/tests/data/tmbed/tmbed.pred", checkIfExists: true)))
                input[1] = 100
                input[2] = 5
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
