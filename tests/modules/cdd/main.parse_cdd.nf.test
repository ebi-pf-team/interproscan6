nextflow_process {

    name "Test Process PARSE_CDD"
    script "modules/cdd/main.nf"
    process "PARSE_CDD"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = [
                    1, 
                    file("${projectDir}/tests/data/cdd/rpsbproc.out"),
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
