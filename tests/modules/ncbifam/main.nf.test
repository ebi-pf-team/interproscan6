nextflow_process {

    name "Test Process PARSE_NCBIFAM"
    script "modules/ncbifam/main.nf"
    process "PARSE_NCBIFAM"

    test("Should run without failures") {

        setup {
            run("GUNZIP") {
                script "../gunzip/main.nf"
                process {
                    """
                    input[0] = file("${projectDir}/tests/data/ncbifam/hmmsearch.out.gz", checkIfExists: true)
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = GUNZIP.out.map { file -> tuple(1, file) }
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
