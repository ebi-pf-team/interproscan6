nextflow_process {

    name "Test Process FIND_DATABASES"
    script "modules/download/main.nf"
    process "FIND_DATABASES"

    test("Should run without failures") {

        setup {
            run("UNTAR") {
                script "../untar/main.nf"
                process {
                    """
                    input[0] = file("${projectDir}/tests/data/find-databases.tar.gz", checkIfExists: true)
                    """
                }
            }
        }    

        when {
            params {
                appl_dirs = [
                    antifam: ["antifam", ""],
                    pfam   : ["pfam", ""]
                ]
                applications = ["antifam", "pfam"]
                n = "interpro"
                v = "105.0"
                p = "$baseDir/tests/data/databases/interpro/105.0"
                json_database = "$baseDir/tests/data/databases/interpro/105.0/databases.json"
                apps_to_run = ["antifam"]
                app_dirs = [
                    "antifam": ["antifam", ""],
                    "pfam"   : ["pfam",    ""]
                ]
                datadir = "$baseDir/tests/data/databases"
            }

            process {
                """
                UNTAR.out
                    .multiMap { dir ->
                        databases: dir.resolve("interpro/108.0/databases.json") 
                        directory: dir                  }
                    .set { inputs }

                input[0] = ["", ""]
                input[1] = inputs.databases
                input[2] = params.applications
                input[3] = params.appl_dirs
                input[4] = inputs.directory
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
