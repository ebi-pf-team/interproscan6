nextflow_process {

    name "Test Process REPRESENTATIVE_LOCATIONS"
    script "modules/representative_locations/main.nf"
    process "REPRESENTATIVE_LOCATIONS"

    test("Should run without failures") {

        setup {
            run("GUNZIP") {
                script "../gunzip/main.nf"
                process {
                    """
                    input[0] = file("${projectDir}/tests/data/combined/combined-with-xrefs.json.gz", 
                                    checkIfExists: true)
                    """
                }
            }            
        }        

        when {
            process {
                """
                input[0] = GUNZIP.out.map { file -> tuple(1, file) }
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()

            with (process.out) {
                assert size() == 1
                assert get(0).size() == 1
                def json1 = "tests/data/combined/combined-with-repr-locations.json.gz"
                def json2 = get(0).get(0).get(1)
                def cmd  = "python tests/diff.py --representative-locations-only ${json1} ${json2}"
                def proc = cmd.execute()
                proc.waitFor()
                assert proc.exitValue() == 0

                json1 = "tests/data/combined/combined-with-xrefs.json.gz"
                cmd  = "python tests/diff.py --representative-locations-only ${json1} ${json2}"
                proc = cmd.execute()
                proc.waitFor()
                assert proc.exitValue() != 0
            }
        }

    }

}
