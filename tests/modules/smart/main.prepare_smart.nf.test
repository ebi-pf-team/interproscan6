nextflow_process {

    name "Test Process PREPARE_SMART"
    script "modules/smart/main.nf"
    process "PREPARE_SMART"

    test("Should run without failures") {

        setup {
            run("GUNZIP") {
                script "../gunzip/main.nf"
                process {
                    """
                    input[0] = file("${projectDir}/tests/data/smart/hmmsearch.out.gz", checkIfExists: true)
                    """
                }
            }

            run("UNTAR") {
                script "../untar/main.nf"
                process {
                    """
                    input[0] = file("${projectDir}/tests/data/smart/models.tar.gz", checkIfExists: true)
                    """
                }
            }
        }

        when {
            process {
                """
                def fasta = file("${projectDir}/tests/data/sequences/input.1.fasta", checkIfExists: true)
                input[0] = GUNZIP.out.map { file -> tuple(1, file, fasta) }
                input[1] = UNTAR.out.map { directory -> directory.resolve("models") }
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
