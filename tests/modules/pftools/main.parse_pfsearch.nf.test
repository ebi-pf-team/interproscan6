nextflow_process {

    name "Test Process PARSE_PFSEARCH"
    script "modules/pftools/main.nf"
    process "PARSE_PFSEARCH"

    test("Should parse HAMAP results without failures") {

        when {
            process {
                """
                input[0] = channel.of(tuple(1, file("${projectDir}/tests/data/hamap/pfsearch.out", checkIfExists: true)))
                input[1] = "HAMAP"
                input[2] = ""
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should parse PROSITE profiles results") {

        when {
            process {
                """
                input[0] = channel.of(tuple(1, file("${projectDir}/tests/data/prosite/pfsearch.out", checkIfExists: true)))
                input[1] = "PROSITE profiles"
                input[2] = file("${projectDir}/tests/data/prosite/skip_flagged_profiles.txt", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
