nextflow_process {

    name "Test Process PREPARE_FUNFAM"
    script "modules/cath/main.nf"
    process "PREPARE_FUNFAM"

    test("Should run without failures") {

        when {
            process {
                """
                def json = file("${projectDir}/tests/data/cath/gene3d/cathgene3d.json", checkIfExists: true)
                input[0] = channel.of(tuple(1, 2, json))
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
