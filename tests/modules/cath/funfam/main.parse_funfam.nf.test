nextflow_process {

    name "Test Process PARSE_FUNFAM"
    script "modules/cath/funfam/main.nf"
    process "PARSE_FUNFAM"

    test("Should run without failures") {
        setup {
            run("GUNZIP") {
                script "../../gunzip/main.nf"
                process {
                    """
                    input[0] = file("${projectDir}/tests/data/cath/funfam/hmmsearch.out.gz", 
                                    checkIfExists: true)
                    """
                }
            }
        }

        when {
            process {
                """
                def tsv = file("${projectDir}/tests/data/cath/funfam/resolved.out", checkIfExists: true)
                input[0] = GUNZIP.out.map { file -> tuple(1, 2, file, tsv) }
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
