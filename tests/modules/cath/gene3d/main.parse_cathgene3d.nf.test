nextflow_process {

    name "Test Process PARSE_CATHGENE3D"
    script "modules/cath/gene3d/main.nf"
    process "PARSE_CATHGENE3D"

    test("Should run without failures") { 
        setup {
            run("GUNZIP") {
                script "../../gunzip/main.nf"
                process {
                    """
                    input[0] = file("${projectDir}/tests/data/cath/gene3d/hmmsearch.out.gz", 
                                    checkIfExists: true)
                    """
                }
            }
        }

        when {
            process {
                """
                def tsv = file("${projectDir}/tests/data/cath/gene3d/cath.tsv", checkIfExists: true)
                
                input[0] = GUNZIP.out.map { file -> tuple(1, 2, file, tsv) }
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
