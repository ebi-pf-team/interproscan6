nextflow_process {

    name "Test Process WRITE_TSV"
    script "modules/output/tsv/main.nf"
    process "WRITE_TSV"

    setup {
        run("GUNZIP") {
            script "../../gunzip/main.nf"
            process {
                """
                input[0] = file("${projectDir}/tests/data/combined/combined-with-repr-locations.json.gz", checkIfExists: true)
                """
            }
        }            
    }      

    test("Write output for protein sequences") {

        when {
            process {
                """
                input[0] = GUNZIP.out.map { file -> [file] }
                input[1] = file("output.tsv")
                input[2] = file("${projectDir}/tests/data/sequences/sequences.db", checkIfExists: true)
                input[3] = false
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()

            with (process.out) {
                assert size() == 1
                assert get(0).size() == 1
                def expfile = "tests/data/output/test.faa.tsv.gz"
                def obsfile = get(0).get(0)
                def cmd  = "python tests/diff.py ${expfile} ${obsfile}"
                def proc = cmd.execute()
                proc.waitFor()
                assert proc.exitValue() == 0
            }            
        }

    }

}
