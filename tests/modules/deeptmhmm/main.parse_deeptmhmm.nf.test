nextflow_process {

    name "Test Process PARSE_DEEPTMHMM"
    script "modules/deeptmhmm/main.nf"
    process "PARSE_DEEPTMHMM"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = channel.of(tuple(1, file("${projectDir}/tests/data/deeptmhmm", checkIfExists: true)))
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
