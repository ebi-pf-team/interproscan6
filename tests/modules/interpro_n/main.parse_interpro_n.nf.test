nextflow_process {

    name "Test Process PARSE_INTERPRO_N"
    script "modules/interpro_n/main.nf"
    process "PARSE_INTERPRO_N"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = channel.of(tuple(
                    1,
                    [file("${projectDir}/tests/data/interpro_n/output.json", checkIfExists: true)],
                    file("${projectDir}/tests/data/sequences/input.1.fasta", checkIfExists: true)
                ))
                input[1] = ["cathgene3d", "pirsf", "prints", "sfld", "smart", "superfamily"]
                input[2] = 2047
                input[3] = 1000
                input[4] = 0.25
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should ignore single-residue matches") {

        when {
            process {
                """
                input[0] = channel.of(tuple(
                    1,
                    [file("${projectDir}/tests/data/interpro_n/single_residue.json", checkIfExists: true)],
                    file("${projectDir}/tests/data/sequences/single_residue.fasta", checkIfExists: true)
                ))
                input[1] = ["pfam"]
                input[2] = 2047
                input[3] = 1000
                input[4] = 0.25
                """
            }
        }

        then {
            assert process.success

            def results = new groovy.json.JsonSlurper().parse(
                file(process.out[0][0][1])
            )
            def locations = results["A22569F613AC86D4C26AE958BDB56012"]["InterPro-N::PF18874"].locations

            // The model reports PF18874 at 474-525, 661-661 and 711-711:
            // only the first one is kept
            assert locations.size() == 1
            assert locations[0].start == 474
            assert locations[0].end == 525

            assert snapshot(process.out).match()
        }

    }

}
