nextflow_process {

    name "Test Process PARSE_COILS"
    script "modules/coils/main.nf"
    process "PARSE_COILS"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = [
                    1, 
                    file("${projectDir}/tests/data/coils/coils.out"),
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
