nextflow_process {

    name "Test Process LOAD_ORFS"
    script "modules/prepare_sequences/main.nf"
    process "LOAD_ORFS"

    test("Should run without failures") {

        setup {
            run("GUNZIP", alias: "GUNZIP1") {
                script "../gunzip/main.nf"
                process {
                    """
                    input[0] = file("${projectDir}/tests/data/sequences/translated.fasta.gz", checkIfExists: true)
                    """
                }
            }

            run("GUNZIP", alias: "GUNZIP2") {
                script "../gunzip/main.nf"
                process {
                    """
                    input[0] = file("${projectDir}/tests/data/sequences/fna.db.gz", checkIfExists: true)
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = GUNZIP1.out
                input[1] = GUNZIP2.out
                """
            }
        }

        then {
            assert process.success
            // assert snapshot(process.out).match()
        }

    }

}
