nextflow_process {

    name "Test Process VALIDATE_FASTA"
    script "modules/prepare_sequences/main.nf"
    process "VALIDATE_FASTA"

    test("Should validate protein sequences without illegal amino acids") {

        when {
            process {
                """
                input[0] = file("${projectDir}/assets/test.faa", checkIfExists: true)
                input[1] = false
                """
            }
        }

        then {
            assert process.success
            assert process.out[1].get(0) == null
            assert snapshot(process.out).match()
        }

    }

    test("Should validate protein sequences with illegal amino acids") {

        when {
            process {
                """
                input[0] = file("${projectDir}/tests/data/sequences/illegal.faa", checkIfExists: true)
                input[1] = false
                """
            }
        }

        then {
            assert process.success
            assert process.out[1].get(0) == "sp|Q63722|JAG1_RAT"
            assert snapshot(process.out).match()
        }

    }

    test("Should validate nucleic sequences without illegal nucleic acids") {

        when {
            process {
                """
                input[0] = file("${projectDir}/assets/test.fna", checkIfExists: true)
                input[1] = true
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should validate nucleic sequences with illegal nucleic acids") {

        when {
            process {
                """
                input[0] = file("${projectDir}/tests/data/sequences/illegal.fna", checkIfExists: true)
                input[1] = true
                """
            }
        }

        then {
            assert process.success
            assert process.out[1].get(0) == "ENA|AAB06509|AAB06509.1"
            assert snapshot(process.out).match()
        }

    }

}
