nextflow_process {

    name "Test Process PREPARE_TREEGRAFTER"
    script "modules/panther/main.nf"
    process "PREPARE_TREEGRAFTER"

    test("Should run without failures") {

        setup {
            run("GUNZIP") {
                script "../gunzip/main.nf"
                process {
                    """
                    input[0] = file("${projectDir}/tests/data/panther/hmmsearch.out.gz", checkIfExists: true)
                    """
                }
            }

            run("UNTAR") {
                script "../untar/main.nf"
                process {
                    """
                    input[0] = file("${projectDir}/tests/data/panther/msf.tar.gz", checkIfExists: true)
                    """
                }
            }
        }    

        when {
            process {
                """
                input[0] = GUNZIP.out.map { file -> tuple(1, 1, file) }
                input[1] = UNTAR.out.map { directory -> directory.resolve("msf") }
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
