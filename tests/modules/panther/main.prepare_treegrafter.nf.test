nextflow_process {

    name "Test Process PREPARE_TREEGRAFTER"
    script "modules/panther/main.nf"
    process "PREPARE_TREEGRAFTER"

    test("Should run without failures") {

        setup {
            run("GUNZIP") {
                script "../gunzip/main.nf"
                process {
                    """
                    input[0] = file("${projectDir}/tests/data/panther/hmmsearch.out.gz", checkIfExists: true)
                    """
                }
            }
        }    

        when {
            process {
                """
                input[0] = GUNZIP.out.map { file -> tuple(1, 1, file) }
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()

            with (process.out) {
                assert size() == 1
                assert get(0).size() == 1
                assert get(0).get(0).size() == 3
                def json = get(0).get(0).get(2)

                def cmd  = "python tests/diff.py -q tests/data/panther/panther.json ${json}"
                def proc = cmd.execute()
                proc.waitFor()
                assert proc.exitValue() == 0
            }
        }

    }

}
