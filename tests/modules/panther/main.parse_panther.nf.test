nextflow_process {

    name "Test Process PARSE_PANTHER"
    script "modules/panther/main.nf"
    process "PARSE_PANTHER"

    test("Should run without failures") {

        when {
            process {
                """
                def json = file("${projectDir}/tests/data/panther/panther.json", checkIfExists: true)
                def tsv  = file("${projectDir}/tests/data/panther/epang.tsv", checkIfExists: true)
                input[0] = channel.of(tuple(1, 2, json, tsv))
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
