nextflow_workflow {

    name "Test suborkflow COMBINE"
    script "subworkflows/combine/main.nf"
    workflow "COMBINE"

    test("Should skip finding representative locations and run without failures") {
        when {
            params {
                match_results = [
                    [
                        1,
                        file("$baseDir/tests/data/channels/antifam.json"),
                        file("$baseDir/tests/data/channels/pfam.json"),
                        file("$baseDir/tests/data/channels/no_matches.json")
                    ]
                ]
                db_releases = [
                    interpro: [version: "105.0", dirpath: "$baseDir/tests/data/databases/interpro/105.0"],
                    antifam: [version: "8.0", dirpath: ""],
                    cathgene3d: [version: "4.3.0", dirpath: ""],
                    cathfunfam: [version: "4.3.0", dirpath: ""],
                    cdd: [version: "3.21", dirpath: ""],
                    hamap: [version: "2025_01", dirpath: ""],
                    ncbifam: [version: "17.0", dirpath: ""],
                    panther: [version: "19.0", dirpath: ""],
                    pfam: [version: "37.3", dirpath: ""],
                    pirsf: [version: "3.10", dirpath: ""],
                    pirsr: [version: "2025_01", dirpath: ""],
                    prints: [version: "42.0", dirpath: ""],
                    prositepatterns: [version: "2025_01", dirpath: ""],
                    prositeprofiles: [version: "2025_01", dirpath: ""],
                    sfld: [version: "4", dirpath: ""],
                    smart: [version: "9.0", dirpath: ""],
                    superfamily: [version: "1.75", dirpath: ""]
                ]
                add_goterms = true
                add_pathways = true
                panther_paint_dir = "$baseDir/tests/data/databases/interpro/105.0"
                skip_repr_locations = true
                batch_size = 5000
            }
            workflow {
                """
                input[0] = params.match_results
                input[1] = params.db_releases
                input[2] = params.add_goterms
                input[3] = params.add_pathways
                input[4] = params.panther_paint_dir
                input[5] = params.skip_repr_locations
                input[6] = params.batch_size
                """
            }
        }
        then {
            assert workflow.success
        }
    }

    test("Should find representative locations and run without failures") {
        when {
            params {
                match_results = [
                    [
                        1,
                        file("$baseDir/tests/data/channels/antifam.json"),
                        file("$baseDir/tests/data/channels/pfam.json"),
                        file("$baseDir/tests/data/channels/no_matches.json")
                    ]
                ]
                db_releases = [
                    interpro: [version: "105.0", dirpath: "$baseDir/tests/data/databases/interpro/105.0"],
                    antifam: [version: "8.0", dirpath: ""],
                    cathgene3d: [version: "4.3.0", dirpath: ""],
                    cathfunfam: [version: "4.3.0", dirpath: ""],
                    cdd: [version: "3.21", dirpath: ""],
                    hamap: [version: "2025_01", dirpath: ""],
                    ncbifam: [version: "17.0", dirpath: ""],
                    panther: [version: "19.0", dirpath: ""],
                    pfam: [version: "37.3", dirpath: ""],
                    pirsf: [version: "3.10", dirpath: ""],
                    pirsr: [version: "2025_01", dirpath: ""],
                    prints: [version: "42.0", dirpath: ""],
                    prositepatterns: [version: "2025_01", dirpath: ""],
                    prositeprofiles: [version: "2025_01", dirpath: ""],
                    sfld: [version: "4", dirpath: ""],
                    smart: [version: "9.0", dirpath: ""],
                    superfamily: [version: "1.75", dirpath: ""]
                ]
                add_goterms = true
                add_pathways = true
                panther_paint_dir = "tests/data/databases/interpro/105.0"
                skip_repr_locations = false
                batch_size = 5000
            }
            workflow {
                """
                input[0] = params.match_results
                input[1] = params.db_releases
                input[2] = params.add_goterms
                input[3] = params.add_pathways
                input[4] = params.panther_paint_dir
                input[5] = params.skip_repr_locations
                input[6] = params.batch_size
                """
            }
        }
        then {
            assert workflow.success
        }
    }
}
