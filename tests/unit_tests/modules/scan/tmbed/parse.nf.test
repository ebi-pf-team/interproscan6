nextflow_process {

    name "Test Process PARSE_TMBED"
    script "modules/tmbed/main.nf"
    process "PARSE_TMBED"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = [1, file("$baseDir/tests/data/channels/tmbed.pred")]
                input[1] = 100
                input[2] = 5
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
