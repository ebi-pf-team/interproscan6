nextflow_process {

    name "Test Process PREPARE_TMBED"
    script "modules/tmbed/main.nf"
    process "PREPARE_TMBED"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = [1, file("$baseDir/tests/data/channels/tmbed.faa")]
                input[1] = 3000
                input[2] = 100
                input[3] = 100
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
