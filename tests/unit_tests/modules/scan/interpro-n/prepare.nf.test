nextflow_process {
    name "Test PREPARE_INTERPRO_N"
    script "modules/interpro-n/main.nf"
    process "PREPARE_INTERPRO_N"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = [1, file("$baseDir/tests/data/sequences/test.faa")]
                input[1] = 5000
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}