nextflow_process {
    name "Test PARSE_INTERPRO_N"
    script "modules/interpro-n/main.nf"
    process "PARSE_INTERPRO_N"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = [1, [file("$baseDir/tests/data/channels/interpro-n.json")]]
                input[1] = []
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}