nextflow_workflow {

    name "Test Workflow OUTPUT"
    script "subworkflows/output/main.nf"
    workflow "OUTPUT"

    def runCmd = { cmdList ->
        def proc = cmdList.execute()
        def out = new StringBuilder()
        def err = new StringBuilder()
        proc.consumeProcessOutput(out, err)
        proc.waitFor()
        if (proc.exitValue() != 0) {
            println "Command failed: ${cmdList.join(' ')}"
            println "stdout: ${out}"
            println "stderr: ${err}"
        }
        return proc.exitValue() == 0
    }

    def validateXml = { String file, boolean gzipped ->
        String schema = "assets/schema.xsd"
        def cmd = gzipped
            ? "gunzip -c ${file} | xmllint --noout --schema ${schema} -"
            : "xmllint --noout --schema ${schema} ${file}"
        return runCmd(["bash", "-c", cmd])
    }

    def validateJson = { String file, boolean gzipped ->
        String schema = "assets/schema.json"
        def cmd = gzipped
            ? "gunzip -c ${file} | check-jsonschema --schemafile ${schema} /dev/stdin"
            : "check-jsonschema --schemafile ${schema} ${file}"
        return runCmd(["bash", "-c", cmd])
    }

    test("Write output for protein sequences") {

        setup {
            run("GUNZIP") {
                script "../../modules/gunzip/main.nf"
                process {
                    """
                    input[0] = file("${projectDir}/tests/data/combined/combined-with-repr-locations.json.gz",
                                    checkIfExists: true)
                    """
                }
            }
        }

        when {
            workflow {
                """
                input[0] = GUNZIP.out.map { file -> [file] }
                input[1] = file("${projectDir}/tests/data/sequences/faa.db", checkIfExists: true)
                input[2] = ["gff3", "json", "jsonl", "tsv", "xml"]
                input[3] = "results"
                input[4] = false
                input[5] = "108.0"
                input[6] = "6.0.x"
                """
            }
        }

        then {
            assert workflow.success

            with (workflow.out) {
                assert get(0).size() == 1
                assert get(0).get(0).size() == 5

                def obsfiles = get(0).get(0)
                def basepath = "tests/data/output/test.faa"

                assertAll(
                    {
                        assert obsfiles.every { obsfile ->
                            def suffix = obsfile.split(/\./)[-1]
                            runCmd(["python", "tests/diff.py", "-q", "${basepath}.${suffix}.gz", obsfile])
                        }
                    },
                    {
                        assert obsfiles.findAll { it.endsWith(".xml") }
                                       .every { validateXml(it, false) }
                    },
                    {
                        assert obsfiles.findAll { it.endsWith(".json") }
                                       .every { validateJson(it, false) }
                    }
                )
            }
        }
    }

    test("Write output for nucleic sequences") {

        setup {
            run("UNTAR") {
                script "../../modules/untar/main.nf"
                process {
                    """
                    input[0] = file("${projectDir}/tests/data/combined/nucleic-combined-with-repr-locations.tar.gz",
                                    checkIfExists: true)
                    """
                }
            }

            run("GUNZIP") {
                script "../../modules/gunzip/main.nf"
                process {
                    """
                    input[0] = file("${projectDir}/tests/data/sequences/fna.db.gz", checkIfExists: true)
                    """
                }
            }
        }

        when {
            workflow {
                """
                input[0] = UNTAR.out.map { dir -> [
                    dir.resolve("1.json"),
                    dir.resolve("2.json"),
                    dir.resolve("3.json"),
                    dir.resolve("4.json"),
                    dir.resolve("5.json")
                ]}
                input[1] = GUNZIP.out
                input[2] = ["gff3", "json", "jsonl", "tsv", "xml"]
                input[3] = "results"
                input[4] = true
                input[5] = "108.0"
                input[6] = "6.0.x"
                """
            }
        }

        then {
            assert workflow.success

            with (workflow.out) {
                assert get(0).size() == 1
                assert get(0).get(0).size() == 5

                def obsfiles = get(0).get(0)
                def basepath = "tests/data/output/test.fna"

                assertAll(
                    {
                        assert obsfiles.every { obsfile ->
                            def suffix = obsfile.split(/\./)[-1]
                            runCmd(["python", "tests/diff.py", "-q", "${basepath}.${suffix}.gz", obsfile])
                        }
                    },
                    {
                        assert obsfiles.findAll { it.endsWith(".xml") }
                                       .every { validateXml(it, false) }
                    },
                    {
                        assert obsfiles.findAll { it.endsWith(".json") }
                                       .every { validateJson(it, false) }
                    }
                )
            }
        }
    }

    test("Validate XML outputs") {
        then {
            assert [
                "tests/data/output/test.faa.xml.gz",
                "tests/data/output/test.fna.xml.gz"
            ].every { validateXml(it, true) }
        }
    }

    test("Validate JSON outputs") {
        then {
            assert [
                "tests/data/output/test.faa.json.gz",
                "tests/data/output/test.fna.json.gz"
            ].every { validateJson(it, true) }
        }
    }
}