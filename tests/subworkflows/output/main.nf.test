nextflow_workflow {

    name "Test Workflow OUTPUT"
    script "subworkflows/output/main.nf"
    workflow "OUTPUT"

    def runCmd = { cmd ->
        def proc = cmd.execute()
        def out = new StringBuilder()
        def err = new StringBuilder()
        proc.consumeProcessOutput(out, err)
        proc.waitFor()
        if (proc.exitValue() != 0) {
            println "Command failed: ${cmd.join(' ')}"
            println "stdout:\n${out}"
            println "stderr:\n${err}"
        }
        proc.exitValue() == 0
    }

    def validateXml = { file ->
        runCmd(["xmllint", "--noout", "--schema", "assets/schema.xsd", file])
    }

    def validateJson = { file ->
        runCmd(["check-jsonschema", "--schemafile", "assets/schema.json", file])
    }

    def validateOutputs = { obsfiles, basepath ->
        assertAll({ assert obsfiles.every { obsfile ->
                    def suffix = obsfile.split(/\./)[-1]
                    runCmd([
                        "python",
                        "tests/diff.py",
                        "-q",
                        "${basepath}.${suffix}.gz",
                        obsfile
                    ])}},
            { assert obsfiles.findAll { it.endsWith(".xml") }.every { validateXml(it) }},
            {assert obsfiles.findAll { it.endsWith(".json") }.every { validateJson(it) }}
        )
    }

    test("Write output for protein sequences") {

        setup {
            run("GUNZIP") {
                script "../../modules/gunzip/main.nf"
                process {
                    """
                    input[0] = file("${projectDir}/tests/data/combined/combined-with-repr-locations.json.gz",
                                    checkIfExists: true)
                    """
                }
            }
        }

        when {
            workflow {
                """
                input[0] = GUNZIP.out.map { file -> [file] }
                input[1] = file("${projectDir}/tests/data/sequences/faa.db", checkIfExists: true)
                input[2] = ["gff3", "json", "jsonl", "tsv", "xml"]
                input[3] = "results"
                input[4] = false
                input[5] = "108.0"
                input[6] = "6.0.x"
                """
            }
        }

        then {
            assert workflow.success

            with (workflow.out) {
                assert get(0).size() == 1
                assert get(0).get(0).size() == 5
                validateOutputs(get(0).get(0), "tests/data/output/test.faa")
            }
        }
    }

    test("Write output for nucleic sequences") {

        setup {
            run("UNTAR") {
                script "../../modules/untar/main.nf"
                process {
                    """
                    input[0] = file("${projectDir}/tests/data/combined/nucleic-combined-with-repr-locations.tar.gz",
                                    checkIfExists: true)
                    """
                }
            }

            run("GUNZIP") {
                script "../../modules/gunzip/main.nf"
                process {
                    """
                    input[0] = file("${projectDir}/tests/data/sequences/fna.db.gz", checkIfExists: true)
                    """
                }
            }
        }

        when {
            workflow {
                """
                input[0] = UNTAR.out.map { dir -> [
                    dir.resolve("1.json"),
                    dir.resolve("2.json"),
                    dir.resolve("3.json"),
                    dir.resolve("4.json"),
                    dir.resolve("5.json")
                ]}
                input[1] = GUNZIP.out
                input[2] = ["gff3", "json", "jsonl", "tsv", "xml"]
                input[3] = "results"
                input[4] = true
                input[5] = "108.0"
                input[6] = "6.0.x"
                """
            }
        }

        then {
            assert workflow.success

            with (workflow.out) {
                assert get(0).size() == 1
                assert get(0).get(0).size() == 5
                validateOutputs(get(0).get(0), "tests/data/output/test.fna")
            }
        }
    }
}