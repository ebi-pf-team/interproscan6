executor {
    name = 'awsbatch'
}

process {
    executor = 'awsbatch'
    withLabel: 'mem_min'        { memory = {  4.GB * task.attempt } }
    withLabel: 'mem_low'        { memory = {  4.GB * task.attempt } }
    withName : 'SEARCH_GENE3D'  { memory = {  6.GB * task.attempt } }

    withLabel:use_gpu {
        accelerator = 1
    }
}