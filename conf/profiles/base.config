executor {
    name = 'local'
    if (params.maxWorkers != null) {
        cpus = params.maxWorkers
    }
}

process {
    executor        = 'local'
    cpus            = 1
    maxRetries      = 3
    errorStrategy   = { task.exitStatus in ((130..145) + 104 + 1 + 9 + 97 + 0) ? "retry" : "finish" }
    withLabel: 'mem_min'     { memory = { 1.GB * task.attempt } }
    withLabel: 'mem_low'     { memory = { 2.GB * task.attempt } }
    withLabel: 'mem_medium'  { memory = { 3.GB * task.attempt } }
    withLabel: 'mem_high'    { memory = { 4.GB * task.attempt } }
    withLabel: 'mem_max'     { memory = { 8.GB * task.attempt } }
    withLabel: 'time_short'  { time   = { 1.h  * task.attempt } }
    withLabel: 'time_medium' { time   = { 4.h  * task.attempt } }
    withLabel: 'time_long'   { time   = { 12.h * task.attempt } }
    withLabel: 'dynamic'     { cpus   = { params.cpus         } }
    withName: 'DOWNLOAD_INTERPRO|DOWNLOAD_DATABASE' {
        errorStrategy = 'retry'
    }
}
