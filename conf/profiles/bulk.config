params {
    batchSize    = 100000
    subBatchSize = 5000
}

process {
    withLabel: 'bigmem' { // used by PRINTS
        memory = { 14.GB * task.attempt }
    }

    // Increase time for specific processes
    withName: 'PREPROCESS_HAMAP' {
        time   = { 2.h  * task.attempt }
    }
    withName: 'RUN_PFSEARCH' {
        time   = { 4.h * task.attempt }
    }
    withName: 'RUN_TREEGRAFTER' {
        time   = { 12.h  * task.attempt }
    }
    withName: 'SEARCH_NCBIFAM' {
        time   = { 6.h * task.attempt }
    }
    withName: 'SEARCH_PFAM' {
        time   = { 4.h * task.attempt }
    }
    withName: 'SEARCH_PHOBIUS' {
        time   = { 4.h * task.attempt }
    }
    withName: 'SEARCH_PIRSR' {
        time   = { 2.h * task.attempt }
    }
    withName: 'SEARCH_SMART' {
        time   = { 24.h * task.attempt }
    }
    
    // ML and licensed methods
    withName: 'RUN_DEEPTMHMM_CPU' {
        time   = { 12.h  * task.attempt }
    }
    withName: 'RUN_DEEPTMHMM_GPU' {
        memory = { 8.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    withName: 'RUN_TMBED_CPU' {
        time   = { 12.h  * task.attempt }
    }
    withName: 'SEARCH_PHOBIUS' {
        time   = { 12.h  * task.attempt }
    }

    withLabel: 'signalpCPU' {
        memory = { 8.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
    withLabel: 'signalpGPU' {
        memory = { 8.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
}
