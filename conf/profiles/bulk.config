params {
    batchSize    = 100000
    subBatchSize = 5000
}

process {
    withLabel: 'long' {
        time   = { 24.h  * task.attempt }
    }
    withLabel: 'bigmem' {
        memory = { 16.GB * task.attempt }
    }

    // Increase time for specific processes
    withName: 'PREPROCESS_HAMAP' {
        cpus   = { 1                   }
        memory = { 1.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName: 'RUN_MOBIDBLITE' {
        cpus   = { 1                   }
        memory = { 1.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName: 'RUN_PFSEARCH' {
        cpus   = { 1                   }
        memory = { 1.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'RUN_TREEGRAFTER' {
        cpus   = { 1                    }
        memory = { 2.GB  * task.attempt }
        time   = { 12.h  * task.attempt }
    }
    withName: 'SEARCH_NCBIFAM' {
        cpus   = { 1                   }
        memory = { 1.GB * task.attempt }
        time   = { 6.h  * task.attempt }
    }
    withName: 'SEARCH_PFAM' {
        cpus   = { 1                   }
        memory = { 1.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'SEARCH_PHOBIUS' {
        cpus   = { 1                   }
        memory = { 2.GB * task.attempt }
        time   = { 6.h  * task.attempt }
    }
    withName: 'SEARCH_PIRSR' {
        cpus   = { 1                   }
        memory = { 1.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName: 'SEARCH_SMART' {
        cpus   = { 1                   }
        memory = { 2.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'SEARCH_SUPERFAMILY' {
        cpus   = { 1                   }
        memory = { 2.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
}