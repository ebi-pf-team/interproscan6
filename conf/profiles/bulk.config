params {
    batchSize    = 100000
    subBatchSize = 5000
}

process {
    withLabel: 'mem_low'     { memory = { 4.GB  * task.attempt } }
    withLabel: 'mem_medium'  { memory = { 8.GB  * task.attempt } }
    withLabel: 'mem_high'    { memory = { 16.GB * task.attempt } }
    withLabel: 'time_short'  { time   = { 3.h   * task.attempt } }
    withLabel: 'time_medium' { time   = { 6.h   * task.attempt } }
    withLabel: 'time_long'   { time   = { 12.h  * task.attempt } }
    withName: 'RUN_PRINTS' {
        memory = { 16.GB * task.attempt }
    }
    withName: 'RUN_PFSEARCH' {
        time   = { 12.h  * task.attempt }
    }
}