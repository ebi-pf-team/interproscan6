params {
    batchSize    = 100000
    subBatchSize = 5000
}

process {
    withLabel: 'mem_min'     { memory = { 16.GB * task.attempt } }
    withLabel: 'mem_low'     { memory = { 16.GB * task.attempt } }
    withLabel: 'mem_medium'  { memory = { 16.GB * task.attempt } }
    withLabel: 'mem_high'    { memory = { 16.GB * task.attempt } }
    withLabel: 'time_short'  { time   = { 12.h  * task.attempt } }
    withLabel: 'time_medium' { time   = { 12.h  * task.attempt } }
    withLabel: 'time_long'   { time   = { 12.h * task.attempt } }
}