executor {
    name            = 'slurm'
    queueSize       = 1000
    exitReadTimeout = '30 min'
    submitRateLimit = '10/1sec'
    jobName         = {
        task.name // [] and ' ' may not be allowed in job names
            .replace('[', '(')
            .replace(']', ')')
            .replace(' ', '_')
    }
}

process {
    executor = 'slurm'

    withLabel: use_gpu {
        clusterOptions = '--gres=gpu:1'
    }
}